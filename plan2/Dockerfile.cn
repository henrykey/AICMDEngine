ARG NODE_BASE_IMAGE=docker.1ms.run/node:20-alpine
ARG NGINX_BASE_IMAGE=docker.1ms.run/nginx:alpine

FROM ${NODE_BASE_IMAGE} AS builder

WORKDIR /app

COPY package*.json package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com \
    && npm ci

COPY . .
RUN npm run build

FROM ${NGINX_BASE_IMAGE} AS production

RUN apk add --no-cache curl

COPY --from=builder /app/dist /usr/share/nginx/html

ENV MEMBERSHIP_UPSTREAM=http://host.docker.internal:8080

RUN mkdir -p /etc/nginx/templates \
    && cat > /etc/nginx/templates/default.conf.template << 'EOF'
upstream mcp_router {
    server mcp-router:8000;
    keepalive 16;
}

server {
    listen 5122;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://mcp_router;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/ {
        proxy_pass http://mcp_router;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location /v2/ {
        proxy_pass ${MEMBERSHIP_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }
}
EOF

EXPOSE 5122

CMD ["nginx", "-g", "daemon off;"]

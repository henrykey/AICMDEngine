{
  "version": 1,
  "modes": [
    "default",
    "low",
    "high",
    "disabled"
  ],
  "sources": [
    "https://developers.openai.com/api/docs/guides/reasoning?api-mode=chat",
    "https://api-docs.deepseek.com/guides/thinking_mode/",
    "https://help.aliyun.com/zh/model-studio/qwen-api-via-openai-chat-completions",
    "https://docs.z.ai/guides/capabilities/thinking",
    "https://github.com/MoonshotAI/Kimi-K3"
  ],
  "profiles": {
    "effort": {
      "low": {
        "reasoning_effort": "low"
      },
      "high": {
        "reasoning_effort": "high"
      }
    },
    "effort_off": {
      "low": {
        "reasoning_effort": "low"
      },
      "high": {
        "reasoning_effort": "high"
      },
      "disabled": {
        "reasoning_effort": "none"
      }
    },
    "thinking_effort": {
      "low": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "low"
      },
      "high": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "high"
      },
      "disabled": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "thinking_switch": {
      "disabled": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "glm52": {
      "high": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "high"
      },
      "disabled": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "qwen38": {
      "low": {
        "enable_thinking": true,
        "reasoning_effort": "low"
      },
      "high": {
        "enable_thinking": true,
        "reasoning_effort": "xhigh"
      },
      "disabled": {
        "enable_thinking": false
      }
    },
    "qwen38_forced": {
      "low": {
        "reasoning_effort": "low"
      },
      "high": {
        "reasoning_effort": "xhigh"
      }
    },
    "qwen_switch": {
      "disabled": {
        "enable_thinking": false
      }
    }
  },
  "rules": [
    {
      "id": "openai-switch",
      "hosts": [
        "api.openai.com"
      ],
      "models": "gpt-5\\.[1245](-[0-9]{4}-[0-9]{2}-[0-9]{2})?",
      "profile": "effort_off",
      "note": "Supports low/high and disabling reasoning."
    },
    {
      "id": "openai-reasoning",
      "hosts": [
        "api.openai.com"
      ],
      "models": "(gpt-5(-mini|-nano)?|o1|o3(-mini)?|o4-mini)(-[0-9]{4}-[0-9]{2}-[0-9]{2})?",
      "profile": "effort",
      "note": "This model cannot disable reasoning."
    },
    {
      "id": "deepseek",
      "hosts": [
        "api.deepseek.com"
      ],
      "models": "deepseek-(flash|pro|v4-flash|v4-pro|v4\\.1-flash|chat|reasoner)",
      "profile": "thinking_effort",
      "note": "Native low/high effort; thinking can be disabled."
    },
    {
      "id": "qwen38",
      "hosts": [
        "dashscope.aliyuncs.com",
        "dashscope-intl.aliyuncs.com",
        "dashscope-us.aliyuncs.com",
        "maas.qwencloudapi.com",
        "*.maas.aliyuncs.com"
      ],
      "models": "qwen3\\.8-(27b|max|max-0902|flash)",
      "profile": "qwen38",
      "note": "high maps to native xhigh; low maps to native low. No thinking_budget is sent."
    },
    {
      "id": "qwen38-forced",
      "hosts": [
        "dashscope.aliyuncs.com",
        "dashscope-intl.aliyuncs.com",
        "dashscope-us.aliyuncs.com",
        "maas.qwencloudapi.com",
        "*.maas.aliyuncs.com"
      ],
      "models": "qwen3\\.8-2\\.4t-a95b",
      "profile": "qwen38_forced",
      "note": "high maps to native xhigh. Thinking cannot be disabled."
    },
    {
      "id": "qwen-switch",
      "hosts": [
        "dashscope.aliyuncs.com",
        "dashscope-intl.aliyuncs.com",
        "dashscope-us.aliyuncs.com",
        "maas.qwencloudapi.com",
        "*.maas.aliyuncs.com"
      ],
      "models": "(qwen3-vl-(flash|plus)|qwen3\\.5-(plus|flash|27b|35b-a3b|122b-a10b|397b-a17b)|qwen3-(8b|14b|32b|30b-a3b|235b-a22b))",
      "profile": "qwen_switch",
      "note": "Only the thinking switch is verified; low/high effort is not supported."
    },
    {
      "id": "zai53",
      "hosts": [
        "api.z.ai",
        "open.bigmodel.cn"
      ],
      "models": "glm-5\\.3(-flash)?",
      "profile": "effort",
      "note": "Thinking cannot be disabled."
    },
    {
      "id": "zai52",
      "hosts": [
        "api.z.ai",
        "open.bigmodel.cn"
      ],
      "models": "glm-5\\.2",
      "profile": "glm52",
      "note": "low is unavailable: the service maps low to high."
    },
    {
      "id": "zai-switch",
      "hosts": [
        "api.z.ai",
        "open.bigmodel.cn"
      ],
      "models": "glm-(5|5\\.1|4\\.5|4\\.5-air|4\\.5v|4\\.6|4\\.7)",
      "profile": "thinking_switch",
      "note": "Only the thinking switch is verified; low/high effort is not supported."
    },
    {
      "id": "kimi3",
      "hosts": [
        "api.moonshot.cn",
        "api.moonshot.ai",
        "api.kimi.com",
        "api.kimi.ai"
      ],
      "models": "kimi-k3",
      "profile": "effort",
      "note": "Thinking cannot be disabled."
    },
    {
      "id": "kimi-switch",
      "hosts": [
        "api.moonshot.cn",
        "api.moonshot.ai",
        "api.kimi.com",
        "api.kimi.ai"
      ],
      "models": "kimi-k2\\.[56]",
      "profile": "thinking_switch",
      "note": "Only the thinking switch is verified; low/high effort is not supported."
    }
  ],
  "cases": [
    {
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.1",
      "mode": "low",
      "expected": {
        "reasoning_effort": "low"
      }
    },
    {
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.1",
      "mode": "disabled",
      "expected": {
        "reasoning_effort": "none"
      }
    },
    {
      "base_url": "https://api.openai.com/v1",
      "model": "o3",
      "mode": "disabled",
      "error": true
    },
    {
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-flash",
      "mode": "high",
      "expected": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "high"
      }
    },
    {
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-flash",
      "mode": "disabled",
      "expected": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    {
      "base_url": "https://dashscope.aliyuncs.com/v1",
      "model": "qwen3.8-27b",
      "mode": "low",
      "expected": {
        "enable_thinking": true,
        "reasoning_effort": "low"
      }
    },
    {
      "base_url": "https://dashscope.aliyuncs.com/v1",
      "model": "qwen3.8-27b",
      "mode": "high",
      "expected": {
        "enable_thinking": true,
        "reasoning_effort": "xhigh"
      }
    },
    {
      "base_url": "https://dashscope.aliyuncs.com/v1",
      "model": "qwen3.8-27b",
      "mode": "disabled",
      "expected": {
        "enable_thinking": false
      }
    },
    {
      "base_url": "https://dashscope.aliyuncs.com/v1",
      "model": "qwen3-vl-plus",
      "mode": "low",
      "error": true
    },
    {
      "base_url": "https://api.z.ai/v1",
      "model": "glm-5.2",
      "mode": "low",
      "error": true
    },
    {
      "base_url": "https://api.z.ai/v1",
      "model": "glm-5.2",
      "mode": "high",
      "expected": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "high"
      }
    },
    {
      "base_url": "https://api.z.ai/v1",
      "model": "glm-5.3",
      "mode": "low",
      "expected": {
        "reasoning_effort": "low"
      }
    },
    {
      "base_url": "https://api.z.ai/v1",
      "model": "glm-5.3",
      "mode": "disabled",
      "error": true
    },
    {
      "base_url": "https://api.moonshot.ai/v1",
      "model": "kimi-k3",
      "mode": "high",
      "expected": {
        "reasoning_effort": "high"
      }
    },
    {
      "base_url": "https://api.moonshot.cn/v1",
      "model": "kimi-k3",
      "mode": "disabled",
      "error": true
    },
    {
      "base_url": "https://api.moonshot.cn/v1",
      "model": "kimi-k2.5",
      "mode": "disabled",
      "expected": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    {
      "base_url": "https://unknown.example/v1",
      "model": "gpt-5.1",
      "mode": "default",
      "expected": {}
    },
    {
      "base_url": "https://unknown.example/v1",
      "model": "gpt-5.1",
      "mode": "low",
      "error": true
    },
    {
      "base_url": "https://api.openai.com.evil.test/v1",
      "model": "gpt-5.1",
      "mode": "low",
      "error": true
    },
    {
      "base_url": "https://api.openai.com/v1",
      "model": "unknown",
      "mode": "low",
      "error": true
    },
    {
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.1",
      "mode": "enabled",
      "error": true
    },
    {
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.1",
      "mode": "medium",
      "error": true
    },
    {
      "base_url": "https://dashscope-intl.aliyuncs.com/v1",
      "model": "QWEN3.8-27B",
      "mode": " LOW ",
      "expected": {
        "enable_thinking": true,
        "reasoning_effort": "low"
      }
    }
  ]
}

# MCP Router Dockerfile
ARG PYTHON_BASE_IMAGE=python:3.11-slim
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10

ARG USE_WHEELHOUSE=false
ARG PIP_INDEX_URL=
ARG APT_MIRROR=

# Install system dependencies
RUN if [ -n "${APT_MIRROR}" ]; then \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g; s|http://security.debian.org/debian-security|${APT_MIRROR}-security|g" /etc/apt/sources.list; \
      fi; \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g; s|http://security.debian.org/debian-security|${APT_MIRROR}-security|g" /etc/apt/sources.list.d/debian.sources; \
      fi; \
    fi \
    && apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
COPY .wheelhouse/mcp-router/ /opt/wheelhouse/

# Install Python dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "${USE_WHEELHOUSE}" = "true" ] && find /opt/wheelhouse -type f ! -name '.gitkeep' ! -name '.requirements.sha256' | grep -q .; then \
      if pip install --no-index --find-links=/opt/wheelhouse -r requirements.txt; then \
        :; \
      elif [ -n "${PIP_INDEX_URL}" ]; then \
        pip install -i "${PIP_INDEX_URL}" -r requirements.txt; \
      else \
        pip install -r requirements.txt; \
      fi; \
    elif [ -n "${PIP_INDEX_URL}" ]; then \
      pip install -i "${PIP_INDEX_URL}" -r requirements.txt; \
    else \
      pip install -r requirements.txt; \
    fi

# Copy application code
COPY src/ src/

# Expose port
EXPOSE 8000

# Run the application
CMD ["python", "-m", "src.main"]

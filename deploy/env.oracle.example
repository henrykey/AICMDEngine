# AIPlanner Oracle deployment environment example
# Copy to deploy/.env before rendering or running docker compose.

APP_PUBLIC_DOMAIN=
APP_INTERNAL_IP=
DB_INTERNAL_IP=
BUILD_PLATFORM=linux/arm64

# Reserved design ports. Do not change.
ROUTER_HOST_PORT=8000
PLAN2_HOST_PORT=5122
OFFICE_WORD_PROXY_PORT=9002
DOCS_CONVERTER_HOST_PORT=9012
PDF2MD_ENHANCED_HOST_PORT=9010
PAGEINDEX_HOST_PORT=9011

ENABLE_EXTERNAL_MCPS=true
ENVIRONMENT=production
MCP_ADMIN_TOKEN=change-me
LOG_LEVEL=INFO

MONGO_HOST=
MONGO_PORT=27017
DATABASE_NAME=nl_tps
MONGODB_URI=mongodb://<mongo-host>:27017/nl_tps?authSource=admin

# Membership hosts login/auth and is the primary MCP client/consumer.
MEMBERSHIP_SERVICE_URL=http://membership-api:8080
JWT_SECRET_KEY=change-me

# Router fallback LLM envs.
# MongoDB active config should take precedence in production.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=

LLM_TIMEOUT=60000
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.8

# Proxy-managed MCP fallback envs.
MCP_TRANSPORT=stdio
FASTMCP_LOG_LEVEL=INFO

# Optional HTTP MCP tuning.
PDF2MD_ENH_PAGE_TIMEOUT_SEC=600
PDF2MD_ENH_VLM_CALL_TIMEOUT_CAP_SEC=600
PAGEINDEX_VLM_CALL_TIMEOUT_CAP_SEC=1200
